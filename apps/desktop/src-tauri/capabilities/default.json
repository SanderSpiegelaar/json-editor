{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Edit JSON files and manage folders explicitly selected through native dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove"
  ]
}
